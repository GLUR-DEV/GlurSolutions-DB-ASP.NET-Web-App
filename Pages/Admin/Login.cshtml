@page
@model LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Sign in | GLUR Admin</title>
  <partial name="_AdminStyles" />
</head>
<body>
  <main class="auth">
    <div class="auth-box">
      <span class="brand">&lt; GLUR <span>Admin</span> /&gt;</span>
      <h1>Sign in</h1>
      @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
      {
        <div class="errors" role="alert">@ViewData.ModelState[string.Empty]!.Errors[0].ErrorMessage</div>
      }
      <form method="post" autocomplete="on">
        <div class="field">
          <label asp-for="Input.Username">Username</label>
          <input asp-for="Input.Username" type="text" autocomplete="username" autofocus maxlength="100" />
          <span asp-validation-for="Input.Username" class="field-validation-error"></span>
        </div>

        <div class="field">
          <label asp-for="Input.Password">Password</label>
          <div class="pw-wrap">
            <input asp-for="Input.Password" type="password" autocomplete="current-password" maxlength="256" />
            <button type="button" class="pw-toggle" id="pw-toggle" aria-controls="Input_Password" aria-pressed="false" hidden>Show</button>
          </div>
          <span asp-validation-for="Input.Password" class="field-validation-error"></span>
        </div>

        <button type="submit" class="btn btn--primary btn--block">Sign in</button>
      </form>
    </div>
  </main>

  <script>
    // The button is hidden until this runs, so with JavaScript off the password simply stays hidden.
    (() => {
      const input = document.getElementById('Input_Password');
      const toggle = document.getElementById('pw-toggle');
      if (!input || !toggle) return;
      toggle.hidden = false;
      toggle.addEventListener('click', () => {
        const show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        toggle.textContent = show ? 'Hide' : 'Show';
        toggle.setAttribute('aria-pressed', show ? 'true' : 'false');
        input.focus();
      });
      // A password left visible should not stay visible in the page history or after a failed attempt
      window.addEventListener('pagehide', () => { input.type = 'password'; });
    })();
  </script>
</body>
</html>
