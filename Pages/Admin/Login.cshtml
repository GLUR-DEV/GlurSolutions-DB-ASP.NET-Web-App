@page
@model LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Sign in | GLUR Admin</title>
  <style>
    :root { --bg:#161a18; --panel:#1f2522; --line:#34403a; --text:#e8efe9; --muted:#9aa8a0; --accent:#7fb896; --danger:#e8806c; }
    * { box-sizing: border-box; }
    body { margin:0; min-height:100vh; display:grid; place-items:center; background:var(--bg); color:var(--text); font:15px/1.5 system-ui, "Segoe UI", sans-serif; }
    .box { width:min(380px, 92vw); background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:24px; }
    h1 { font-size:22px; margin:0 0 16px; }
    label { display:block; font-weight:600; margin:12px 0 4px; }
    input { width:100%; padding:9px 10px; background:var(--bg); color:var(--text); border:1px solid var(--line); border-radius:6px; font:inherit; }
    input:focus { outline:none; border-color:var(--accent); }
    button { margin-top:18px; width:100%; padding:9px 14px; border-radius:6px; border:1px solid var(--accent); background:var(--accent); color:#10221a; font:inherit; font-weight:600; cursor:pointer; }
    .error { color:var(--danger); font-size:14px; margin:0 0 8px; }
    .field-validation-error { color:var(--danger); font-size:13px; }
  </style>
</head>
<body>
  <main class="box">
    <h1>GLUR Admin</h1>
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
      <p class="error" role="alert">@ViewData.ModelState[string.Empty]!.Errors[0].ErrorMessage</p>
    }
    <form method="post" autocomplete="on">
      <label asp-for="Input.Username">Username</label>
      <input asp-for="Input.Username" autocomplete="username" autofocus maxlength="100">
      <span asp-validation-for="Input.Username" class="field-validation-error"></span>

      <label asp-for="Input.Password">Password</label>
      <input asp-for="Input.Password" type="password" autocomplete="current-password" maxlength="256">
      <span asp-validation-for="Input.Password" class="field-validation-error"></span>

      <button type="submit">Sign in</button>
    </form>
  </main>
</body>
</html>
