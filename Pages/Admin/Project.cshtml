@page "{id:int?}"
@model ProjectModel
@{
    ViewData["Title"] = Model.IsNew ? "New project" : "Edit project";
    ViewData["SaveLabel"] = Model.IsNew ? "Create project" : "Save changes";
    ViewData["CancelUrl"] = Url.Page("/Admin/Index");
    if (!Model.IsNew)
    {
        ViewData["ProjectId"] = Model.ProjectId;
        ViewData["ProjectTab"] = "details";
        ViewData["LiveSlug"] = Model.Input.Slug;
    }
}
<p class="crumb"><a asp-page="Index">Projects</a> &rsaquo; @(Model.IsNew ? "New project" : Model.Input.Title)</p>
<div class="head">
  <h1>@(Model.IsNew ? "New project" : "Edit project")</h1>
</div>
@if (!Model.IsNew)
{
  <partial name="_ProjectTabs" />
}
else
{
  <p class="lede">Fill in the basics and create the project as a draft. You can add slideshows and notes once it exists.</p>
}

<form method="post" id="editor">
  <div asp-validation-summary="All"></div>

  <div class="card">
    <h2>Basics</h2>
    <p class="sub">The title, address and the text on the project card.</p>
    <div class="grid">
      <div class="field">
        <label asp-for="Input.Title">Title</label>
        <input asp-for="Input.Title" type="text" maxlength="120" />
        <span asp-validation-for="Input.Title"></span>
      </div>
      <div class="field">
        <label asp-for="Input.Slug">Slug (part of the page address)</label>
        <input asp-for="Input.Slug" type="text" maxlength="80" />
        <span asp-validation-for="Input.Slug"></span>
        <div class="muted">Page address: projects.html?project=<em>slug</em>. Changing it breaks old links to this project.</div>
      </div>
    </div>

    <div class="field">
      <label asp-for="Input.ShortDescription">Short description (the text on the card)</label>
      <input asp-for="Input.ShortDescription" type="text" maxlength="300" />
      <span asp-validation-for="Input.ShortDescription"></span>
    </div>

    <div class="field">
      <label asp-for="Input.Summary">Summary (longer intro at the top of the project page; falls back to the short description)</label>
      <textarea asp-for="Input.Summary" rows="4" maxlength="1000"></textarea>
      <span class="count"></span>
      <span asp-validation-for="Input.Summary"></span>
    </div>
  </div>

  <div class="card">
    <h2>Card picture</h2>
    <p class="sub">Pictures must be hosted online (a full https:// address). Files on your computer will not show on the website.</p>
    <div class="grid">
      <div class="field">
        <label asp-for="Input.CoverImagePath">Picture address</label>
        <input asp-for="Input.CoverImagePath" type="text" maxlength="260" placeholder="https://..." />
        <span asp-validation-for="Input.CoverImagePath"></span>
      </div>
      <div class="field">
        <label asp-for="Input.CoverAlt">Picture description (for screen readers)</label>
        <input asp-for="Input.CoverAlt" type="text" maxlength="200" />
      </div>
    </div>
  </div>

  <div class="card">
    <h2>Details panel</h2>
    <p class="sub">The role, tools and timeframe shown beside the first slideshow.</p>
    <div class="grid">
      <div class="field"><label asp-for="Input.Role">Role</label><input asp-for="Input.Role" type="text" maxlength="120" /></div>
      <div class="field"><label asp-for="Input.Tools">Tools</label><input asp-for="Input.Tools" type="text" maxlength="200" /></div>
      <div class="field"><label asp-for="Input.Timeframe">Timeframe</label><input asp-for="Input.Timeframe" type="text" maxlength="80" /></div>
    </div>
  </div>

  <div class="card">
    <h2>Skills used</h2>
    @if (Model.AllTechnologies.Count == 0)
    {
      <p class="sub">No skills yet. Add some on the <a asp-page="Technologies">Skills</a> page. Cards show the first three.</p>
    }
    else
    {
      <p class="sub">Cards show the first three, in the order set on the Skills page.</p>
      <div class="chips">
        @foreach (var t in Model.AllTechnologies)
        {
          <label class="chip">
            <input type="checkbox" name="SelectedTechnologyIds" value="@t.Id" @(Model.SelectedTechnologyIds.Contains(t.Id) ? "checked" : "") />
            @t.Label
          </label>
        }
      </div>
    }
  </div>

  <div class="card">
    <h2>Publishing</h2>
    <p class="sub">Drafts are hidden from the website. Lowest sort number shows first.</p>
    <div class="grid">
      <div class="field">
        <label asp-for="Input.SortOrder">Sort order (lowest first)</label>
        <input asp-for="Input.SortOrder" type="number" />
      </div>
      <div class="field">
        <label>Visibility</label>
        <label class="switch"><input asp-for="Input.IsPublished" type="checkbox" /> Published (visible on glursolutions.com)</label>
      </div>
    </div>
  </div>
</form>
