@page "{projectId:int}"
@model NotesModel
@{
    ViewData["Title"] = "Notes";
    ViewData["SaveLabel"] = "Save notes";
    ViewData["CancelUrl"] = Url.Page("/Admin/Index");
    ViewData["ProjectId"] = Model.ProjectId;
    ViewData["ProjectTab"] = "notes";
    ViewData["LiveSlug"] = Model.ProjectSlug;
    var blank = new NotesModel.NoteRow { SortOrder = Model.Rows.Count + 1 };
    var all = Model.Rows.Concat(new[] { blank }).ToList();
}
<p class="crumb"><a asp-page="Index">Projects</a> &rsaquo; <a asp-page="Project" asp-route-id="@Model.ProjectId">@Model.ProjectTitle</a> &rsaquo; Notes</p>
<div class="head">
  <h1>Side-panel notes</h1>
</div>
<partial name="_ProjectTabs" />
<p class="lede">Each note is a bold heading plus one sentence. <strong>Feedback</strong> notes appear beside the first slideshow, <strong>Improved</strong> notes ("What improved") beside the second. Edit the rows, then press <strong>Save notes</strong> once.</p>

@if (Model.Errors.Count > 0)
{
  <div class="errors" role="alert">
    <strong>Nothing was saved.</strong>
    <ul>@foreach (var problem in Model.Errors) { <li>@problem</li> }</ul>
  </div>
}

<form method="post" id="editor" data-confirm="Delete the notes marked for deletion? This cannot be undone.">
  <div id="rows">
  @for (var i = 0; i < all.Count; i++)
  {
    var r = all[i];
    <div class="row-card" data-row @(r.Id == 0 ? "data-new" : "data-existing")>
      <input type="hidden" name="Rows.index" value="@i" />
      <input type="hidden" name="Rows[@i].Id" value="@r.Id" />
      <div class="row-head">
        <span class="row-no">@(i + 1)</span>
        <span class="row-title" data-empty="New note">@(string.IsNullOrWhiteSpace(r.Heading) ? "New note" : r.Heading)</span>
        <span class="grow"></span>
        <button type="button" class="btn btn--ghost btn--sm" data-remove-row hidden>Remove</button>
        <label class="del"><input type="checkbox" class="del-box" name="Rows[@i].Delete" value="true" /> Delete</label>
      </div>
      <div class="grid">
        <div class="field">
          <label>Panel</label>
          <select name="Rows[@i].Kind">
            @foreach (var k in Enum.GetValues<NoteKind>())
            {
              <option value="@k" selected="@(r.Kind == k)">@k</option>
            }
          </select>
        </div>
        <div class="field"><label>Heading</label><input type="text" name="Rows[@i].Heading" value="@r.Heading" maxlength="80" placeholder="Navigation" /></div>
        <div class="field"><label>Sort order</label><input type="number" name="Rows[@i].SortOrder" value="@r.SortOrder" /></div>
      </div>
      <div class="field">
        <label>Text</label>
        <textarea name="Rows[@i].Body" rows="2" maxlength="400">@r.Body</textarea>
        <span class="count"></span>
      </div>
    </div>
  }
  </div>
  <button type="button" class="btn btn--ghost add-row" data-add="#rows">+ Add another note</button>
</form>
