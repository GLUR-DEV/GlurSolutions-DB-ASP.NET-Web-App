@page "{projectId:int}"
@model SlideshowsModel
@{
    ViewData["Title"] = "Slideshows";
    ViewData["SaveLabel"] = "Save slideshows";
    ViewData["CancelUrl"] = Url.Page("/Admin/Index");
    ViewData["ProjectId"] = Model.ProjectId;
    ViewData["ProjectTab"] = "slideshows";
    ViewData["LiveSlug"] = Model.ProjectSlug;
    var blank = new SlideshowsModel.SlideshowRow { SortOrder = Model.Rows.Count + 1 };
    var all = Model.Rows.Concat(new[] { blank }).ToList();
}
<p class="crumb"><a asp-page="Index">Projects</a> &rsaquo; <a asp-page="Project" asp-route-id="@Model.ProjectId">@Model.ProjectTitle</a> &rsaquo; Slideshows</p>
<div class="head">
  <h1>Slideshows</h1>
</div>
<partial name="_ProjectTabs" />
<p class="lede">A project page shows one <strong>Process</strong> slideshow (wireframe to final product) and one <strong>Improvement</strong> slideshow (changes over time). If a project has several of the same kind, the website shows the first one that has slides. Edit the rows, then press <strong>Save slideshows</strong> once. Slides are edited on their own page, so save here first.</p>

@if (Model.Errors.Count > 0)
{
  <div class="errors" role="alert">
    <strong>Nothing was saved.</strong>
    <ul>@foreach (var problem in Model.Errors) { <li>@problem</li> }</ul>
  </div>
}

<form method="post" id="editor" data-confirm="Delete the slideshows marked for deletion, with all their slides? This cannot be undone.">
  <div id="rows">
  @for (var i = 0; i < all.Count; i++)
  {
    var r = all[i];
    <div class="row-card" data-row @(r.Id == 0 ? "data-new" : "data-existing")>
      <input type="hidden" name="Rows.index" value="@i" />
      <input type="hidden" name="Rows[@i].Id" value="@r.Id" />
      <div class="row-head">
        <span class="row-no">@(i + 1)</span>
        <span class="row-title" data-empty="New slideshow">@(string.IsNullOrWhiteSpace(r.Heading) ? "New slideshow" : r.Heading)</span>
        <span class="grow"></span>
        @if (r.Id != 0)
        {
          <a class="btn btn--ghost btn--sm" asp-page="Slides" asp-route-slideshowId="@r.Id">
            Edit slides (@(Model.SlideCounts.TryGetValue(r.Id, out var slideCount) ? slideCount : 0))
          </a>
        }
        <button type="button" class="btn btn--ghost btn--sm" data-remove-row hidden>Remove</button>
        <label class="del"><input type="checkbox" class="del-box" name="Rows[@i].Delete" value="true" /> Delete</label>
      </div>
      <div class="grid">
        <div class="field">
          <label>Kind</label>
          <select name="Rows[@i].Kind">
            @foreach (var k in Enum.GetValues<SlideshowKind>())
            {
              <option value="@k" selected="@(r.Kind == k)">@k</option>
            }
          </select>
        </div>
        <div class="field"><label>Heading</label><input type="text" name="Rows[@i].Heading" value="@r.Heading" maxlength="120" placeholder="Wireframe to final product" /></div>
        <div class="field"><label>Sort order</label><input type="number" name="Rows[@i].SortOrder" value="@r.SortOrder" /></div>
      </div>
    </div>
  }
  </div>
  <button type="button" class="btn btn--ghost add-row" data-add="#rows">+ Add another slideshow</button>
</form>
