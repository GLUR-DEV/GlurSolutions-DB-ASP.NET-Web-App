@{
    var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var onSkills = current.Equals("/Admin/Technologies", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>@ViewData["Title"] | GLUR Admin</title>
  <partial name="_AdminStyles" />
</head>
<body>
  <header class="topbar">
    <a class="brand" asp-page="/Admin/Index">&lt; GLUR <span>Admin</span> /&gt;</a>
    <nav class="nav" aria-label="Admin">
      <a asp-page="/Admin/Index" class="@(onSkills ? "" : "active")">Projects</a>
      <a asp-page="/Admin/Technologies" class="@(onSkills ? "active" : "")">Skills</a>
      <a href="https://glursolutions.com" target="_blank" rel="noopener noreferrer">View live site &#8599;</a>
    </nav>
    <span class="spacer"></span>
    <span class="env">Edits reach the website in about 2 minutes</span>
    @if (User.Identity?.IsAuthenticated == true)
    {
      <form method="post" asp-page="/Admin/Logout" class="inline"><button type="submit" class="btn btn--ghost btn--sm">Sign out</button></form>
    }
  </header>

  <main class="page">
    @if (TempData["Message"] is string flashMessage)
    {
      <div class="flash ok" role="status">@flashMessage</div>
    }
    @if (TempData["Error"] is string flashError)
    {
      <div class="flash err" role="alert">@flashError</div>
    }
    @RenderBody()
  </main>

  @if (ViewData["SaveLabel"] is string saveLabel)
  {
    <div class="savebar" role="region" aria-label="Save changes">
      <div class="savebar-in">
        <span class="save-state" id="save-state" role="status">No unsaved changes</span>
        @if (ViewData["CancelUrl"] is string cancelUrl)
        {
          <a class="btn btn--ghost" href="@cancelUrl">Cancel</a>
        }
        <button type="submit" form="editor" class="btn btn--primary">@saveLabel</button>
      </div>
    </div>
  }

  <script>
    (() => {
      const form = document.getElementById('editor');
      const state = document.getElementById('save-state');
      let dirty = false;
      let submitting = false;
      let nextIndex = 1000;

      const markDirty = () => {
        if (dirty) return;
        dirty = true;
        if (state) { state.textContent = 'Unsaved changes'; state.classList.add('is-dirty'); }
      };

      // Character counters on long text boxes
      const updateCount = box => {
        const counter = box.parentElement.querySelector('.count');
        if (counter) counter.textContent = box.value.length + ' / ' + box.maxLength;
      };
      document.querySelectorAll('textarea[maxlength]').forEach(updateCount);

      // Number the rows again after one is added or removed
      const renumber = () => {
        document.querySelectorAll('[data-row] .row-no').forEach((badge, i) => { badge.textContent = i + 1; });
      };

      // Picture preview: show the picture when the address is a full https:// link
      const updatePreview = input => {
        const row = input.closest('[data-row]');
        const img = row && row.querySelector('.thumb');
        if (!img) return;
        const url = input.value.trim();
        if (/^https:\/\/\S+$/i.test(url)) { img.src = url; img.hidden = false; }
        else { img.hidden = true; img.removeAttribute('src'); }
      };
      document.addEventListener('error', e => {
        if (e.target && e.target.classList && e.target.classList.contains('thumb')) e.target.hidden = true;
      }, true);

      if (form) {
        form.addEventListener('input', e => {
          markDirty();
          if (e.target.matches('textarea[maxlength]')) updateCount(e.target);
          if (e.target.matches('.img-input')) updatePreview(e.target);
        });
        form.addEventListener('change', markDirty);
        form.addEventListener('submit', e => {
          const marked = form.querySelectorAll('[data-existing] .del-box:checked').length;
          if (marked > 0) {
            const message = (form.dataset.confirm || 'Delete the items marked for deletion? This cannot be undone.')
              + '\n\n' + marked + ' marked.';
            if (!window.confirm(message)) { e.preventDefault(); return; }
          }
          submitting = true;
        });
        window.addEventListener('beforeunload', e => {
          if (dirty && !submitting) { e.preventDefault(); e.returnValue = ''; }
        });
      }

      // "Add another": copy the empty row at the bottom of the list, give it fresh field names and clear it
      document.addEventListener('click', e => {
        const remove = e.target.closest('[data-remove-row]');
        if (remove) {
          const row = remove.closest('[data-row]');
          if (row) { row.remove(); renumber(); markDirty(); }
          return;
        }
        const add = e.target.closest('[data-add]');
        if (!add) return;
        const list = document.querySelector(add.dataset.add);
        const proto = list && list.querySelector('[data-new]');
        if (!proto) return;

        const copy = proto.cloneNode(true);
        const index = ++nextIndex;
        const count = list.querySelectorAll('[data-row]').length;
        copy.querySelectorAll('input, select, textarea').forEach(field => {
          if (field.name === 'Rows.index') { field.value = index; return; }
          if (field.name) field.name = field.name.replace(/Rows\[\d+\]/, 'Rows[' + index + ']');
          if (field.type === 'hidden') { if (/\.Id$/.test(field.name)) field.value = '0'; }
          else if (field.type === 'checkbox') field.checked = false;
          else if (field.type === 'number') field.value = String(count + 1);
          else if (field.tagName === 'SELECT') field.selectedIndex = 0;
          else field.value = '';
        });
        const thumb = copy.querySelector('.thumb');
        if (thumb) { thumb.hidden = true; thumb.removeAttribute('src'); }
        const title = copy.querySelector('.row-title');
        if (title && title.dataset.empty) title.textContent = title.dataset.empty;
        const rm = copy.querySelector('[data-remove-row]');
        if (rm) rm.hidden = false;
        copy.querySelectorAll('textarea[maxlength]').forEach(updateCount);
        list.appendChild(copy);
        renumber();
        const first = copy.querySelector('input[type=text], textarea');
        if (first) first.focus();
        markDirty();
      });
    })();
  </script>
</body>
</html>
