<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>@ViewData["Title"] | GLUR Admin</title>
  <link rel="stylesheet" href="~/admin/assets/admin.css" />
  <script src="~/admin/assets/admin.js" defer></script>
</head>
<body>
  <header class="bar">
    <strong>GLUR Admin</strong>
    @if (User.Identity?.IsAuthenticated == true)
    {
      <nav>
        <a asp-page="/Admin/Index">Projects</a>
        <a asp-page="/Admin/Technologies">Skills</a>
        <a href="https://glursolutions.com" target="_blank" rel="noopener noreferrer">View live site</a>
      </nav>
      <span class="env">Edits the live database &middot; the website updates within about 2 minutes</span>
      <form method="post" asp-page="/Admin/Logout" class="signout">
        <button type="submit">Sign out</button>
      </form>
    }
  </header>
  <main>
    @if (TempData["Message"] is string flashMessage)
    {
      <div class="flash ok" role="status">@flashMessage</div>
    }
    @if (TempData["Error"] is string flashError)
    {
      <div class="flash err" role="alert">@flashError</div>
    }
    @RenderBody()
  </main>
</body>
</html>
